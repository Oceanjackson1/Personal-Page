---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="问Ocean的龙虾" description="和Ocean的龙虾聊天，基于Ocean所有文章内容回答你的问题">
  <div class="max-w-[var(--width-content)] mx-auto px-4 sm:px-6 pt-8 pb-4 flex flex-col" style="min-height: calc(100vh - 64px - 160px);">

    <!-- Header -->
    <div class="text-center mb-6">
      <div class="text-4xl mb-2">🦞</div>
      <h1 class="text-xl font-semibold mb-1">问Ocean的龙虾</h1>
      <p class="text-sm text-[color:var(--color-text-tertiary)]">基于 Ocean 的所有文章和代码项目，回答你的问题</p>
    </div>

    <!-- Chat area -->
    <div class="flex-1 overflow-y-auto mb-4 space-y-4" id="chat-area">
      <!-- Suggestions (empty state) -->
      <div id="suggestions" class="flex flex-col items-center gap-3 pt-8">
        <p class="text-sm text-[color:var(--color-text-tertiary)] mb-2">试试问我：</p>
        <div class="flex flex-wrap justify-center gap-2">
          <button class="suggest-btn text-sm px-4 py-2 rounded-full border border-[var(--color-border)] text-[color:var(--color-text-secondary)] hover:text-[color:var(--color-text-primary)] hover:border-[var(--color-text-tertiary)] transition-colors">
            Ocean是谁？
          </button>
          <button class="suggest-btn text-sm px-4 py-2 rounded-full border border-[var(--color-border)] text-[color:var(--color-text-secondary)] hover:text-[color:var(--color-text-primary)] hover:border-[var(--color-text-tertiary)] transition-colors">
            Hyperliquid是什么？
          </button>
          <button class="suggest-btn text-sm px-4 py-2 rounded-full border border-[var(--color-border)] text-[color:var(--color-text-secondary)] hover:text-[color:var(--color-text-primary)] hover:border-[var(--color-text-tertiary)] transition-colors">
            Ocean对预测市场怎么看？
          </button>
          <button class="suggest-btn text-sm px-4 py-2 rounded-full border border-[var(--color-border)] text-[color:var(--color-text-secondary)] hover:text-[color:var(--color-text-primary)] hover:border-[var(--color-text-tertiary)] transition-colors">
            Ocean写过哪些代码项目？
          </button>
        </div>
      </div>
    </div>

    <!-- Input area -->
    <div class="sticky bottom-0 bg-[var(--color-bg)] pt-2 pb-4">
      <div class="flex items-center gap-2 bg-[var(--color-surface)] rounded-2xl px-4 py-3 border border-[var(--color-border)] focus-within:border-[var(--color-text-tertiary)] transition-colors">
        <input
          type="text"
          id="chat-input"
          placeholder="问我关于 Ocean 文章的任何问题..."
          class="flex-1 bg-transparent outline-none text-[15px] text-[color:var(--color-text-primary)] placeholder:text-[color:var(--color-text-tertiary)]"
          autocomplete="off"
        />
        <button id="send-btn" class="shrink-0 p-1.5 rounded-full hover:bg-[var(--color-border)] transition-colors disabled:opacity-30 disabled:pointer-events-none" disabled>
          <svg class="w-5 h-5 text-[color:var(--color-text-secondary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.5 10.5 12 3m0 0 7.5 7.5M12 3v18" />
          </svg>
        </button>
      </div>
      <div class="flex justify-between items-center mt-2 px-1">
        <p class="text-xs text-[color:var(--color-text-tertiary)]">由 Deepseek 驱动 · 基于文章内容回答</p>
        <button id="clear-btn" class="text-xs text-[color:var(--color-text-tertiary)] hover:text-[color:var(--color-text-primary)] transition-colors hidden">
          新对话
        </button>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* Message bubbles */
  .msg-user {
    max-width: 85%;
    margin-left: auto;
    background: var(--color-surface);
    border-radius: 18px 18px 4px 18px;
    padding: 12px 16px;
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-text-primary);
  }

  .msg-bot {
    max-width: 90%;
    margin-right: auto;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 18px 18px 18px 4px;
    padding: 12px 16px;
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-text-primary);
  }

  .msg-bot .lobster-tag {
    font-size: 13px;
    color: var(--color-text-tertiary);
    margin-bottom: 4px;
  }

  /* Streaming cursor */
  .msg-bot .cursor {
    display: inline-block;
    width: 2px;
    height: 1em;
    background: var(--color-text-tertiary);
    margin-left: 2px;
    animation: blink 0.8s step-end infinite;
    vertical-align: text-bottom;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  /* Message content — simple markdown rendering */
  .msg-content p { margin-bottom: 0.5em; }
  .msg-content p:last-child { margin-bottom: 0; }
  .msg-content a {
    color: var(--color-text-primary);
    text-decoration: underline;
    text-decoration-color: var(--color-text-tertiary);
    text-underline-offset: 2px;
  }
  .msg-content a:hover {
    text-decoration-color: var(--color-text-primary);
  }
  .msg-content code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--color-border);
    padding: 0.1em 0.35em;
    border-radius: 4px;
  }
  .msg-content strong { font-weight: 600; }
  .msg-content ul, .msg-content ol { padding-left: 1.25em; margin-bottom: 0.5em; }
  .msg-content li { margin-bottom: 0.15em; }
  .msg-content blockquote {
    border-left: 3px solid var(--color-text-tertiary);
    padding-left: 0.75em;
    color: var(--color-text-secondary);
    font-style: italic;
    margin: 0.5em 0;
  }

  /* Error message */
  .msg-error {
    max-width: 90%;
    margin: 0 auto;
    text-align: center;
    font-size: 13px;
    color: var(--color-text-tertiary);
    padding: 8px 16px;
    background: var(--color-surface);
    border-radius: 12px;
  }
</style>

<script>
  // ─── Types ───
  interface Article {
    type?: 'post' | 'project';
    slug: string;
    title: string;
    description: string;
    category: string;
    url: string;
    body: string;
  }

  interface Message {
    role: 'user' | 'assistant';
    content: string;
  }

  // ─── State ───
  let messages: Message[] = [];
  let lobsterIndex: Article[] | null = null;
  let isLoading = false;

  // ─── DOM ───
  const chatArea = document.getElementById('chat-area')!;
  const suggestions = document.getElementById('suggestions')!;
  const chatInput = document.getElementById('chat-input') as HTMLInputElement;
  const sendBtn = document.getElementById('send-btn') as HTMLButtonElement;
  const clearBtn = document.getElementById('clear-btn') as HTMLButtonElement;

  // ─── Load article index ───
  async function loadIndex(): Promise<Article[]> {
    if (lobsterIndex) return lobsterIndex;

    const cached = sessionStorage.getItem('lobster-index');
    if (cached) {
      lobsterIndex = JSON.parse(cached);
      return lobsterIndex!;
    }

    const res = await fetch('/lobster-index.json');
    const data: Article[] = await res.json();
    lobsterIndex = data;
    sessionStorage.setItem('lobster-index', JSON.stringify(data));
    return data;
  }

  // ─── Find relevant articles ───
  function findRelevantArticles(query: string, articles: Article[], topK = 3): Article[] {
    // Extract query terms: split by common delimiters, also generate 2-grams for Chinese
    const terms = query
      .toLowerCase()
      .replace(/[？?！!。，,、\s]+/g, ' ')
      .trim()
      .split(' ')
      .filter((t) => t.length > 0);

    // Also generate character 2-grams for Chinese matching
    const bigrams: string[] = [];
    const cleaned = query.replace(/[\s？?！!。，,、]/g, '');
    for (let i = 0; i < cleaned.length - 1; i++) {
      bigrams.push(cleaned.slice(i, i + 2).toLowerCase());
    }

    const allTerms = [...terms, ...bigrams];

    const scored = articles.map((article) => {
      const titleLower = article.title.toLowerCase();
      const descLower = article.description.toLowerCase();
      const bodyLower = article.body.toLowerCase();

      let score = 0;
      for (const term of allTerms) {
        if (titleLower.includes(term)) score += 3;
        if (descLower.includes(term)) score += 2;
        if (bodyLower.includes(term)) score += 1;
      }
      return { article, score };
    });

    return scored
      .filter((s) => s.score > 0)
      .sort((a, b) => b.score - a.score)
      .slice(0, topK)
      .map((s) => s.article);
  }

  // ─── Build system prompt ───
  function buildSystemPrompt(articles: Article[]): string {
    let context = '';
    if (articles.length > 0) {
      context = articles
        .map((a) => {
          const tag = a.type === 'project' ? '【代码项目】' : '【文章】';
          return `${tag}【${a.title}】(${a.url})\n${a.body.slice(0, 2000)}`;
        })
        .join('\n\n---\n\n');
    } else {
      context = '（未找到与问题直接相关的文章或项目）';
    }

    return `你是"Ocean的龙虾"🦞，一只博学、有趣的龙虾助手。你的工作是根据Ocean（倪钰桐）的博客文章和代码项目来回答用户的问题。

规则：
1. 基于下方提供的文章和项目内容回答问题。如果没有相关信息，诚实地说"Ocean的内容里暂时没有涉及这个话题哦🦞"。
2. 回答时自然地引用来源，比如"在Ocean的《xxx》这篇文章里提到..."或"Ocean开发过一个叫xxx的项目..."。
3. 保持友好、有趣的语气，你是一只有性格的龙虾。
4. 回答用中文，除非用户用英文提问。
5. 在回答末尾推荐相关文章或项目链接，格式为：📖 推荐阅读：[标题](url) 或 💻 相关项目：[项目名](github链接)
6. 回答简洁有力，不要过于冗长。
7. 如果用户问代码/技术栈/项目相关的问题，优先引用代码项目的信息。

以下是与用户问题最相关的内容（包含文章和代码项目）：

${context}`;
  }

  // ─── Simple markdown to HTML ───
  function simpleMarkdown(text: string): string {
    return text
      // Bold
      .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
      // Inline code
      .replace(/`([^`]+)`/g, '<code>$1</code>')
      // Links
      .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>')
      // Blockquotes
      .replace(/^> (.+)$/gm, '<blockquote>$1</blockquote>')
      // Unordered lists
      .replace(/^[-*] (.+)$/gm, '<li>$1</li>')
      // Paragraphs (double newline)
      .replace(/\n\n/g, '</p><p>')
      // Single newlines within paragraphs → <br>
      .replace(/\n/g, '<br>');
  }

  // ─── Render messages ───
  function renderMessages(streaming = false) {
    // Keep suggestions or remove
    if (messages.length > 0) {
      suggestions.style.display = 'none';
      clearBtn.classList.remove('hidden');
    }

    // Build HTML from messages
    const msgElements = messages.map((msg, i) => {
      if (msg.role === 'user') {
        return `<div class="msg-user">${escapeHtml(msg.content)}</div>`;
      } else {
        const isLast = i === messages.length - 1;
        const cursor = streaming && isLast ? '<span class="cursor"></span>' : '';
        return `<div class="msg-bot">
          <div class="lobster-tag">🦞 Ocean的龙虾</div>
          <div class="msg-content"><p>${simpleMarkdown(msg.content)}${cursor}</p></div>
        </div>`;
      }
    });

    // Replace chat area content (keep suggestions div)
    const existingMsgs = chatArea.querySelectorAll('.msg-user, .msg-bot, .msg-error');
    existingMsgs.forEach((el) => el.remove());

    chatArea.insertAdjacentHTML('beforeend', msgElements.join(''));
    chatArea.scrollTop = chatArea.scrollHeight;
  }

  function escapeHtml(text: string): string {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  // ─── Send message ───
  async function sendMessage(userInput: string) {
    if (isLoading || !userInput.trim()) return;
    isLoading = true;
    sendBtn.disabled = true;
    chatInput.disabled = true;

    // Add user message
    messages.push({ role: 'user', content: userInput.trim() });
    renderMessages();

    try {
      // Load index and find relevant articles
      const index = await loadIndex();
      const relevant = findRelevantArticles(userInput, index);
      const systemPrompt = buildSystemPrompt(relevant);

      // Build conversation (system + last 6 messages)
      const recentMessages = messages.slice(-6);
      const apiMessages = [
        { role: 'system', content: systemPrompt },
        ...recentMessages,
      ];

      // Add empty assistant message for streaming
      messages.push({ role: 'assistant', content: '' });
      renderMessages(true);

      // Call Deepseek API
      const response = await fetch('https://api.deepseek.com/chat/completions', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': 'Bearer sk-589ae78225394e4c842ee72cec346fb5',
        },
        body: JSON.stringify({
          model: 'deepseek-chat',
          messages: apiMessages,
          stream: true,
          max_tokens: 2048,
          temperature: 0.7,
        }),
      });

      if (!response.ok) {
        throw new Error(`API error: ${response.status}`);
      }

      // Stream the response
      const reader = response.body!.getReader();
      const decoder = new TextDecoder();
      let buffer = '';

      while (true) {
        const { done, value } = await reader.read();
        if (done) break;

        buffer += decoder.decode(value, { stream: true });
        const lines = buffer.split('\n');
        buffer = lines.pop() || '';

        for (const line of lines) {
          const trimmed = line.trim();
          if (!trimmed || !trimmed.startsWith('data: ')) continue;
          const data = trimmed.slice(6);
          if (data === '[DONE]') break;

          try {
            const parsed = JSON.parse(data);
            const delta = parsed.choices?.[0]?.delta?.content;
            if (delta) {
              messages[messages.length - 1].content += delta;
              renderMessages(true);
            }
          } catch {
            // Skip malformed JSON chunks
          }
        }
      }

      // Final render without cursor
      renderMessages(false);
    } catch (err) {
      // Remove the empty assistant message if streaming failed
      if (messages[messages.length - 1].role === 'assistant' && messages[messages.length - 1].content === '') {
        messages.pop();
      }
      renderMessages(false);

      const errorMsg = (err as Error).message?.includes('429')
        ? '🦞 龙虾需要休息一下，请稍后再问'
        : '🦞 网络连接出了问题，请稍后重试';
      chatArea.insertAdjacentHTML('beforeend', `<div class="msg-error">${errorMsg}</div>`);
      chatArea.scrollTop = chatArea.scrollHeight;
    } finally {
      isLoading = false;
      sendBtn.disabled = !chatInput.value.trim();
      chatInput.disabled = false;
      chatInput.focus();
    }
  }

  // ─── Event listeners ───
  chatInput.addEventListener('input', () => {
    sendBtn.disabled = !chatInput.value.trim() || isLoading;
  });

  chatInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) {
      e.preventDefault();
      const value = chatInput.value;
      chatInput.value = '';
      sendBtn.disabled = true;
      sendMessage(value);
    }
  });

  sendBtn.addEventListener('click', () => {
    const value = chatInput.value;
    chatInput.value = '';
    sendBtn.disabled = true;
    sendMessage(value);
  });

  clearBtn.addEventListener('click', () => {
    messages = [];
    const existingMsgs = chatArea.querySelectorAll('.msg-user, .msg-bot, .msg-error');
    existingMsgs.forEach((el) => el.remove());
    suggestions.style.display = '';
    clearBtn.classList.add('hidden');
    chatInput.focus();
  });

  // Suggestion buttons
  document.querySelectorAll('.suggest-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const text = (btn as HTMLElement).textContent?.trim() || '';
      chatInput.value = '';
      sendMessage(text);
    });
  });
</script>
