---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="问Ocean的龙虾" description="和Ocean的龙虾聊天，基于Ocean所有文章和代码项目回答你的问题">
  <div class="lobster-wrapper">

    <!-- Chat messages area — scrollable -->
    <div class="lobster-messages" id="chat-area">
      <!-- Empty state: header + suggestions together -->
      <div id="suggestions" class="suggestions-wrap">
        <div class="text-4xl sm:text-5xl mb-3">🦞</div>
        <h1 class="text-2xl sm:text-3xl font-semibold">问Ocean的龙虾</h1>
        <p class="text-sm sm:text-base text-[color:var(--color-text-tertiary)] mt-1 mb-8">基于 Ocean 的所有文章和代码项目，回答你的问题</p>
        <div class="flex flex-wrap justify-center gap-2 max-w-md">
          <button class="suggest-btn">Ocean是谁？</button>
          <button class="suggest-btn">Hyperliquid是什么？</button>
          <button class="suggest-btn">Ocean对预测市场怎么看？</button>
          <button class="suggest-btn">Ocean写过哪些代码项目？</button>
        </div>
      </div>
    </div>

    <!-- Input area — pinned at bottom -->
    <div class="lobster-input-wrap">
      <div class="lobster-input-bar">
        <input
          type="text"
          id="chat-input"
          placeholder="问我关于 Ocean 文章或代码项目的任何问题..."
          class="lobster-input"
          autocomplete="off"
        />
        <button id="send-btn" class="lobster-send-btn" disabled>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.5 10.5 12 3m0 0 7.5 7.5M12 3v18" />
          </svg>
        </button>
      </div>
      <div class="flex justify-between items-center mt-1.5 px-1">
        <p class="text-[11px] text-[color:var(--color-text-tertiary)]">由 Deepseek 驱动 · 基于文章与代码项目回答</p>
        <button id="clear-btn" class="text-[11px] text-[color:var(--color-text-tertiary)] hover:text-[color:var(--color-text-primary)] transition-colors hidden">
          新对话
        </button>
      </div>
    </div>
  </div>
</BaseLayout>

<style is:global>
  /* ─── Layout: full viewport chat ─── */
  .lobster-wrapper {
    max-width: var(--width-content);
    margin: 0 auto;
    padding: 0 1rem;
    display: flex;
    flex-direction: column;
    height: calc(100vh - 64px);
    height: calc(100dvh - 64px);
  }

  .lobster-messages {
    flex: 1;
    overflow-y: auto;
    padding: 0.5rem 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 0;
    scroll-behavior: smooth;
  }

  .lobster-input-wrap {
    flex-shrink: 0;
    padding: 0.5rem 0 1rem;
    background: var(--color-bg);
  }

  @media (max-width: 639px) {
    .lobster-wrapper {
      height: calc(100vh - 48px);
      height: calc(100dvh - 48px);
    }
    .lobster-input-wrap {
      padding: 0.375rem 0 0.625rem;
    }
  }

  @media (min-width: 640px) {
    .lobster-wrapper { padding: 0 1.5rem; }
  }

  /* ─── Suggestions ─── */
  .suggestions-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    flex: 1;
    padding: 0;
  }

  .suggest-btn {
    font-size: 12px;
    padding: 0.4rem 0.875rem;
    border-radius: 9999px;
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    background: transparent;
    cursor: pointer;
    transition: all 0.15s;
  }
  .suggest-btn:hover {
    color: var(--color-text-primary);
    border-color: var(--color-text-tertiary);
  }

  /* ─── Input bar ─── */
  .lobster-input-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--color-surface);
    border-radius: 18px;
    padding: 0.625rem 0.75rem 0.625rem 1rem;
    border: 1px solid var(--color-border);
    transition: border-color 0.15s;
  }
  .lobster-input-bar:focus-within {
    border-color: var(--color-text-tertiary);
  }

  .lobster-input {
    flex: 1;
    background: transparent;
    outline: none;
    font-size: 14px;
    color: var(--color-text-primary);
    font-family: inherit;
  }

  @media (min-width: 640px) {
    .lobster-input { font-size: 15px; }
  }
  .lobster-input::placeholder {
    color: var(--color-text-tertiary);
  }

  .lobster-send-btn {
    flex-shrink: 0;
    padding: 0.375rem;
    border-radius: 9999px;
    color: var(--color-text-secondary);
    transition: background 0.15s;
    cursor: pointer;
    background: transparent;
    border: none;
  }
  .lobster-send-btn:hover:not(:disabled) {
    background: var(--color-border);
  }
  .lobster-send-btn:disabled {
    opacity: 0.3;
    pointer-events: none;
  }

  /* ─── Message rows ─── */
  .msg-row {
    display: flex;
    gap: 0.625rem;
    align-items: flex-start;
    animation: msgFadeIn 0.25s ease-out;
  }
  .msg-row-user {
    flex-direction: row-reverse;
  }

  @keyframes msgFadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .msg-avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    flex-shrink: 0;
    margin-top: 2px;
  }
  .msg-avatar-user {
    background: var(--color-text-primary);
    color: var(--color-bg);
    font-size: 12px;
    font-weight: 600;
  }
  .msg-avatar-bot {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  @media (min-width: 640px) {
    .msg-avatar { width: 32px; height: 32px; font-size: 16px; }
    .msg-avatar-user { font-size: 13px; }
  }

  .msg-body {
    max-width: 85%;
    min-width: 0;
  }

  @media (min-width: 640px) {
    .msg-body { max-width: 80%; }
  }

  .msg-name {
    font-size: 11px;
    color: var(--color-text-tertiary);
    margin-bottom: 2px;
    font-weight: 500;
  }
  .msg-row-user .msg-name {
    text-align: right;
  }

  @media (min-width: 640px) {
    .msg-name { font-size: 12px; margin-bottom: 3px; }
  }

  .msg-bubble {
    padding: 8px 12px;
    font-size: 14px;
    line-height: 1.7;
    color: var(--color-text-primary);
    word-break: break-word;
  }

  @media (min-width: 640px) {
    .msg-bubble { padding: 10px 14px; font-size: 15px; }
  }
  .msg-bubble-user {
    background: var(--color-surface);
    border-radius: 18px 18px 4px 18px;
  }
  .msg-bubble-bot {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 18px 18px 18px 4px;
  }

  /* ─── Typing indicator ─── */
  .typing-dots {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 4px 0;
  }
  .typing-dots span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-text-tertiary);
    animation: dotBounce 1.2s ease-in-out infinite;
  }
  .typing-dots span:nth-child(2) { animation-delay: 0.15s; }
  .typing-dots span:nth-child(3) { animation-delay: 0.3s; }

  @keyframes dotBounce {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
    30% { transform: translateY(-4px); opacity: 1; }
  }

  /* ─── Streaming cursor ─── */
  .cursor {
    display: inline-block;
    width: 2px;
    height: 1em;
    background: var(--color-text-tertiary);
    margin-left: 2px;
    animation: blink 0.8s step-end infinite;
    vertical-align: text-bottom;
  }
  @keyframes blink { 50% { opacity: 0; } }

  /* ─── Message content markdown ─── */
  .msg-content p { margin-bottom: 0.4em; }
  .msg-content p:last-child { margin-bottom: 0; }
  .msg-content h3 {
    font-size: 0.95em;
    font-weight: 600;
    margin: 0.75em 0 0.3em;
  }
  .msg-content h3:first-child { margin-top: 0; }
  .msg-content h4 {
    font-size: 0.9em;
    font-weight: 600;
    margin: 0.6em 0 0.2em;
  }
  .msg-content a {
    color: var(--color-text-primary);
    text-decoration: underline;
    text-decoration-color: var(--color-text-tertiary);
    text-underline-offset: 2px;
    transition: text-decoration-color 0.15s;
  }
  .msg-content a:hover {
    text-decoration-color: var(--color-text-primary);
  }
  /* GitHub links get a subtle icon */
  .msg-content a[href*="github.com"]::before {
    content: "↗ ";
    font-size: 0.8em;
  }
  .msg-content code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--color-border);
    padding: 0.1em 0.35em;
    border-radius: 4px;
  }
  .msg-content strong { font-weight: 600; }
  .msg-content ul, .msg-content ol {
    padding-left: 1.25em;
    margin: 0.25em 0 0.4em;
  }
  .msg-content li {
    margin-bottom: 0.1em;
    line-height: 1.6;
  }
  .msg-content blockquote {
    border-left: 3px solid var(--color-text-tertiary);
    padding-left: 0.75em;
    color: var(--color-text-secondary);
    font-style: italic;
    margin: 0.4em 0;
  }
  /* Horizontal rule */
  .msg-content hr {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 0.6em 0;
  }

  /* ─── Error ─── */
  .msg-error {
    text-align: center;
    font-size: 13px;
    color: var(--color-text-tertiary);
    padding: 8px 16px;
    background: var(--color-surface);
    border-radius: 12px;
    animation: msgFadeIn 0.25s ease-out;
  }
</style>

<script>
  // ─── Types ───
  interface Article {
    type?: 'post' | 'project';
    slug: string;
    title: string;
    description: string;
    category: string;
    url: string;
    body: string;
  }

  interface Message {
    role: 'user' | 'assistant';
    content: string;
  }

  // ─── State ───
  let messages: Message[] = [];
  let lobsterIndex: Article[] | null = null;
  let isLoading = false;

  // ─── DOM ───
  const chatArea = document.getElementById('chat-area')!;
  const suggestions = document.getElementById('suggestions')!;
  const chatInput = document.getElementById('chat-input') as HTMLInputElement;
  const sendBtn = document.getElementById('send-btn') as HTMLButtonElement;
  const clearBtn = document.getElementById('clear-btn') as HTMLButtonElement;

  // ─── Load article index ───
  async function loadIndex(): Promise<Article[]> {
    if (lobsterIndex) return lobsterIndex;

    const cached = sessionStorage.getItem('lobster-index');
    if (cached) {
      lobsterIndex = JSON.parse(cached);
      return lobsterIndex!;
    }

    const res = await fetch('/lobster-index.json');
    const data: Article[] = await res.json();
    lobsterIndex = data;
    sessionStorage.setItem('lobster-index', JSON.stringify(data));
    return data;
  }

  // ─── Detect if query is about code/projects ───
  const PROJECT_KEYWORDS = ['代码', '项目', '开发', '技术栈', 'github', 'repo', 'code', 'project', '写过', '做过', '工具', '产品'];
  function isProjectQuery(query: string): boolean {
    const q = query.toLowerCase();
    return PROJECT_KEYWORDS.some((kw) => q.includes(kw));
  }

  // ─── Find relevant articles ───
  function findRelevantArticles(query: string, articles: Article[]): Article[] {
    if (isProjectQuery(query)) {
      const allProjects = articles.filter((a) => a.type === 'project');
      const posts = articles.filter((a) => a.type !== 'project');
      const topPosts = scoreAndRank(query, posts, 2);
      return [...allProjects, ...topPosts];
    }

    return scoreAndRank(query, articles, 5);
  }

  function scoreAndRank(query: string, articles: Article[], topK: number): Article[] {
    const terms = query
      .toLowerCase()
      .replace(/[？?！!。，,、\s]+/g, ' ')
      .trim()
      .split(' ')
      .filter((t) => t.length > 0);

    const bigrams: string[] = [];
    const cleaned = query.replace(/[\s？?！!。，,、]/g, '');
    for (let i = 0; i < cleaned.length - 1; i++) {
      bigrams.push(cleaned.slice(i, i + 2).toLowerCase());
    }

    const allTerms = [...terms, ...bigrams];

    const scored = articles.map((article) => {
      const titleLower = article.title.toLowerCase();
      const descLower = article.description.toLowerCase();
      const bodyLower = article.body.toLowerCase();

      let score = 0;
      for (const term of allTerms) {
        if (titleLower.includes(term)) score += 3;
        if (descLower.includes(term)) score += 2;
        if (bodyLower.includes(term)) score += 1;
      }
      return { article, score };
    });

    return scored
      .filter((s) => s.score > 0)
      .sort((a, b) => b.score - a.score)
      .slice(0, topK)
      .map((s) => s.article);
  }

  // ─── Build system prompt ───
  function buildSystemPrompt(articles: Article[]): string {
    let context = '';
    if (articles.length > 0) {
      context = articles
        .map((a) => {
          const tag = a.type === 'project' ? '【代码项目】' : '【文章】';
          return `${tag}【${a.title}】(${a.url})\n${a.body.slice(0, 2000)}`;
        })
        .join('\n\n---\n\n');
    } else {
      context = '（未找到与问题直接相关的文章或项目）';
    }

    return `你是"Ocean的龙虾"🦞，一只博学、有趣的龙虾助手。你的工作是根据Ocean（倪钰桐）的博客文章和代码项目来回答用户的问题。

规则：
1. 基于下方提供的文章和项目内容回答问题。如果没有相关信息，诚实地说"Ocean的内容里暂时没有涉及这个话题哦🦞"。
2. 回答时自然地引用来源，比如"在Ocean的《xxx》这篇文章里提到..."或"Ocean开发过一个叫xxx的项目..."。
3. 保持友好、有趣的语气，你是一只有性格的龙虾。
4. 回答用中文，除非用户用英文提问。
5. 回答简洁有力，不要过于冗长，避免使用过多的分级标题。
6. 每当提到代码项目时，必须附上完整的 GitHub 链接。格式：[项目名](GitHub URL)。这是硬性要求，不能省略。
7. 在回答末尾推荐相关内容，用以下格式：
   - 文章用：📖 [文章标题](文章url)
   - 代码项目用：💻 [项目名](GitHub链接)

以下是与用户问题最相关的内容（包含文章和代码项目）：

${context}`;
  }

  // ─── Simple markdown to HTML ───
  function simpleMarkdown(text: string): string {
    let html = text
      // Horizontal rule
      .replace(/^---$/gm, '<hr>')
      // Headings
      .replace(/^### (.+)$/gm, '<h4>$1</h4>')
      .replace(/^## (.+)$/gm, '<h3>$1</h3>')
      // Bold
      .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
      // Inline code
      .replace(/`([^`]+)`/g, '<code>$1</code>')
      // Links — auto-detect raw URLs too
      .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>')
      .replace(/(?<!")(?<!=)(https:\/\/github\.com\/[^\s<),]+)/g, '<a href="$1" target="_blank" rel="noopener noreferrer">$1</a>')
      // Blockquotes
      .replace(/^> (.+)$/gm, '<blockquote>$1</blockquote>')
      // Numbered list items
      .replace(/^\d+\.\s+(.+)$/gm, '<li>$1</li>')
      // Unordered list items
      .replace(/^[-*] (.+)$/gm, '<li>$1</li>')
      // Paragraphs
      .replace(/\n\n/g, '</p><p>')
      // Single newlines
      .replace(/\n/g, '<br>');

    // Wrap consecutive <li> in <ul>
    html = html.replace(/(<li>.*?<\/li>)(<br>?(<li>.*?<\/li>))*/g, (match) => {
      return '<ul>' + match.replace(/<br>/g, '') + '</ul>';
    });

    return html;
  }

  function escapeHtml(text: string): string {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  // ─── Typing indicator ───
  function showTypingIndicator() {
    const html = `<div class="msg-row" id="typing-indicator">
      <div class="msg-avatar msg-avatar-bot">🦞</div>
      <div class="msg-body">
        <div class="msg-name">Ocean的龙虾</div>
        <div class="msg-bubble msg-bubble-bot">
          <div class="typing-dots"><span></span><span></span><span></span></div>
        </div>
      </div>
    </div>`;
    chatArea.insertAdjacentHTML('beforeend', html);
    chatArea.scrollTop = chatArea.scrollHeight;
  }

  function removeTypingIndicator() {
    document.getElementById('typing-indicator')?.remove();
  }

  // ─── Throttled render for streaming ───
  let renderQueued = false;
  function queueRender() {
    if (renderQueued) return;
    renderQueued = true;
    requestAnimationFrame(() => {
      renderMessages(true);
      renderQueued = false;
    });
  }

  // ─── Render messages ───
  function renderMessages(streaming = false) {
    if (messages.length > 0) {
      suggestions.style.display = 'none';
      clearBtn.classList.remove('hidden');
    }

    const msgElements = messages.map((msg, i) => {
      if (msg.role === 'user') {
        return `<div class="msg-row msg-row-user">
          <div class="msg-avatar msg-avatar-user">你</div>
          <div class="msg-body">
            <div class="msg-name">你</div>
            <div class="msg-bubble msg-bubble-user">${escapeHtml(msg.content)}</div>
          </div>
        </div>`;
      } else {
        const isLast = i === messages.length - 1;
        const cursor = streaming && isLast ? '<span class="cursor"></span>' : '';
        return `<div class="msg-row">
          <div class="msg-avatar msg-avatar-bot">🦞</div>
          <div class="msg-body">
            <div class="msg-name">Ocean的龙虾</div>
            <div class="msg-bubble msg-bubble-bot">
              <div class="msg-content"><p>${simpleMarkdown(msg.content)}${cursor}</p></div>
            </div>
          </div>
        </div>`;
      }
    });

    const existingMsgs = chatArea.querySelectorAll('.msg-row, .msg-error');
    existingMsgs.forEach((el) => el.remove());

    chatArea.insertAdjacentHTML('beforeend', msgElements.join(''));
    chatArea.scrollTop = chatArea.scrollHeight;
  }

  // ─── Send message ───
  async function sendMessage(userInput: string, isSuggestion = false) {
    if (isLoading || !userInput.trim()) return;
    isLoading = true;
    sendBtn.disabled = true;
    chatInput.disabled = true;

    messages.push({ role: 'user', content: userInput.trim() });

    window.amplitude?.track('Lobster Message Sent', {
      message_length: userInput.trim().length,
      is_suggestion: isSuggestion,
      conversation_turn: messages.filter((m) => m.role === 'user').length,
    });

    renderMessages();

    // Show typing indicator while loading
    showTypingIndicator();

    try {
      const index = await loadIndex();
      const relevant = findRelevantArticles(userInput, index);
      const systemPrompt = buildSystemPrompt(relevant);

      const recentMessages = messages.slice(-6);
      const apiMessages = [
        { role: 'system', content: systemPrompt },
        ...recentMessages,
      ];

      // Replace typing indicator with empty assistant message
      messages.push({ role: 'assistant', content: '' });
      removeTypingIndicator();
      renderMessages(true);

      const response = await fetch('https://api.deepseek.com/chat/completions', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': 'Bearer sk-589ae78225394e4c842ee72cec346fb5',
        },
        body: JSON.stringify({
          model: 'deepseek-chat',
          messages: apiMessages,
          stream: true,
          max_tokens: 2048,
          temperature: 0.7,
        }),
      });

      if (!response.ok) {
        throw new Error(`API error: ${response.status}`);
      }

      const reader = response.body!.getReader();
      const decoder = new TextDecoder();
      let buffer = '';

      while (true) {
        const { done, value } = await reader.read();
        if (done) break;

        buffer += decoder.decode(value, { stream: true });
        const lines = buffer.split('\n');
        buffer = lines.pop() || '';

        for (const line of lines) {
          const trimmed = line.trim();
          if (!trimmed || !trimmed.startsWith('data: ')) continue;
          const data = trimmed.slice(6);
          if (data === '[DONE]') break;

          try {
            const parsed = JSON.parse(data);
            const delta = parsed.choices?.[0]?.delta?.content;
            if (delta) {
              messages[messages.length - 1].content += delta;
              queueRender();
            }
          } catch {
            // skip malformed chunks
          }
        }
      }

      renderMessages(false);
    } catch (err) {
      removeTypingIndicator();
      if (messages[messages.length - 1].role === 'assistant' && messages[messages.length - 1].content === '') {
        messages.pop();
      }
      renderMessages(false);

      const errorMsg = (err as Error).message?.includes('429')
        ? '🦞 龙虾需要休息一下，请稍后再问'
        : '🦞 网络连接出了问题，请稍后重试';
      chatArea.insertAdjacentHTML('beforeend', `<div class="msg-error">${errorMsg}</div>`);
      chatArea.scrollTop = chatArea.scrollHeight;
    } finally {
      isLoading = false;
      sendBtn.disabled = !chatInput.value.trim();
      chatInput.disabled = false;
      chatInput.focus();
    }
  }

  // ─── Event listeners ───
  chatInput.addEventListener('input', () => {
    sendBtn.disabled = !chatInput.value.trim() || isLoading;
  });

  chatInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) {
      e.preventDefault();
      const value = chatInput.value;
      chatInput.value = '';
      sendBtn.disabled = true;
      sendMessage(value);
    }
  });

  sendBtn.addEventListener('click', () => {
    const value = chatInput.value;
    chatInput.value = '';
    sendBtn.disabled = true;
    sendMessage(value);
  });

  clearBtn.addEventListener('click', () => {
    messages = [];
    const existingMsgs = chatArea.querySelectorAll('.msg-row, .msg-error');
    existingMsgs.forEach((el) => el.remove());
    suggestions.style.display = '';
    clearBtn.classList.add('hidden');
    chatInput.focus();
  });

  document.querySelectorAll('.suggest-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const text = (btn as HTMLElement).textContent?.trim() || '';
      chatInput.value = '';
      sendMessage(text, true);
    });
  });
</script>
