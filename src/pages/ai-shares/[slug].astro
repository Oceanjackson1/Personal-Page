---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const shares = await getCollection('aiShares');
  return shares.map((share) => ({
    params: { slug: share.data.slug || share.id },
    props: { share },
  }));
}

const { share } = Astro.props;
const { Content, headings } = await render(share);

const allShares = await getCollection('aiShares');
const sortedShares = allShares.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const currentIndex = sortedShares.findIndex(s => s.id === share.id);
const prevShare = currentIndex < sortedShares.length - 1 ? sortedShares[currentIndex + 1] : null;
const nextShare = currentIndex > 0 ? sortedShares[currentIndex - 1] : null;

const readTime = Math.max(1, Math.ceil((share.body?.length || 0) / 400));
const formattedDate = share.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
const isoDate = share.data.date.toISOString();
const isoDateModified = (share.data.updatedDate || share.data.date).toISOString();
const shareSlug = share.data.slug || share.id;
const canonicalURL = new URL(`/ai-shares/${shareSlug}/`, Astro.site);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": share.data.title,
  "description": share.data.description,
  "datePublished": isoDate,
  "dateModified": isoDateModified,
  "articleSection": "AI Sharing",
  "keywords": share.data.tags.join(', '),
  "author": {
    "@type": "Person",
    "name": "Ocean 倪钰桐",
    "url": "https://niyutongocean.xyz"
  },
  "publisher": {
    "@type": "Person",
    "name": "Ocean 倪钰桐"
  },
  "url": canonicalURL.href,
  "wordCount": share.body?.length || 0,
  "timeRequired": `PT${readTime}M`,
  "inLanguage": "zh-CN"
};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Ocean's Blog",
      "item": "https://niyutongocean.xyz"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "AI 分享",
      "item": "https://niyutongocean.xyz/ai-shares/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": share.data.title
    }
  ]
};
---

<BaseLayout title={share.data.title} description={share.data.description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  <!-- Reading progress -->
  <div class="reading-progress" id="reading-progress"></div>

  <article class="py-12 sm:py-16">
    <div class="max-w-[var(--width-content)] mx-auto px-6">
      <!-- Header -->
      <header class="mb-10">
        <div class="flex items-center gap-2 text-sm text-[color:var(--color-text-tertiary)] mb-4 flex-wrap">
          <a href="/ai-shares/" class="hover:text-[color:var(--color-text-primary)] transition-colors"
             data-i18n-zh="AI 分享" data-i18n-en="AI Sharing">AI 分享</a>
          <span>&middot;</span>
          <time>{formattedDate}</time>
          <span>&middot;</span>
          <span>{readTime} <span data-i18n-zh="分钟阅读" data-i18n-en="min read">分钟阅读</span></span>
          {share.data.source && (
            <>
              <span>&middot;</span>
              <a href={share.data.source} target="_blank" rel="noopener noreferrer"
                 class="hover:text-[color:var(--color-text-primary)] transition-colors underline decoration-dotted">
                原文 &nearr;
              </a>
            </>
          )}
        </div>
        <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight mb-4">{share.data.title}</h1>
        {share.data.tags.length > 0 && (
          <div class="flex gap-1.5 flex-wrap mt-4">
            {share.data.tags.map((tag) => (
              <span class="text-xs px-2 py-0.5 rounded-full border border-[var(--color-border)] text-[color:var(--color-text-secondary)]">{tag}</span>
            ))}
          </div>
        )}
      </header>

      <hr class="border-[var(--color-border)] mb-10" />

      <!-- Content -->
      <div class="prose" id="article-content">
        <Content />
      </div>

      <hr class="border-[var(--color-border)] mt-10 mb-8" />

      <!-- Prev/Next -->
      <nav class="flex flex-col gap-4 sm:flex-row sm:justify-between sm:items-center">
        {prevShare ? (
          <a href={`/ai-shares/${prevShare.data.slug || prevShare.id}/`} class="text-sm text-[color:var(--color-text-secondary)] hover:text-[color:var(--color-text-primary)] transition-colors line-clamp-1">
            &larr; {prevShare.data.title}
          </a>
        ) : <div />}
        {nextShare ? (
          <a href={`/ai-shares/${nextShare.data.slug || nextShare.id}/`} class="text-sm text-[color:var(--color-text-secondary)] hover:text-[color:var(--color-text-primary)] transition-colors sm:text-right line-clamp-1">
            {nextShare.data.title} &rarr;
          </a>
        ) : <div />}
      </nav>
    </div>
  </article>

  <!-- TOC (desktop right side) -->
  {headings.length > 0 && (
    <aside class="hidden xl:block fixed right-8 top-1/3 w-48 transition-opacity duration-300" id="toc">
      <p class="text-xs font-medium text-[color:var(--color-text-tertiary)] uppercase tracking-wider mb-3" data-i18n-zh="目录" data-i18n-en="Contents">目录</p>
      <nav class="space-y-1.5">
        {headings.filter(h => h.depth <= 3).map((h) => (
          <a href={`#${h.slug}`}
             class:list={[
               "block text-xs text-[color:var(--color-text-tertiary)] hover:text-[color:var(--color-text-primary)] transition-colors",
               h.depth === 3 && "pl-3"
             ]}>
            {h.text}
          </a>
        ))}
      </nav>
    </aside>
  )}

  <script>
    const progressBar = document.getElementById('reading-progress');
    const article = document.getElementById('article-content');

    function updateProgress() {
      if (!article || !progressBar) return;
      const rect = article.getBoundingClientRect();
      const articleTop = rect.top + window.scrollY;
      const articleHeight = rect.height;
      const scrolled = window.scrollY - articleTop;
      const progress = Math.min(100, Math.max(0, (scrolled / articleHeight) * 100));
      progressBar.style.width = `${progress}%`;
    }

    window.addEventListener('scroll', updateProgress);
    updateProgress();
  </script>

  <script>
    // Wrap tables in horizontally scrollable container
    document.querySelectorAll('.prose table').forEach((table) => {
      if (table.parentElement?.classList.contains('table-wrapper')) return;
      const wrapper = document.createElement('div');
      wrapper.className = 'table-wrapper';
      table.parentNode?.insertBefore(wrapper, table);
      wrapper.appendChild(table);
    });
  </script>

  <script>
    document.querySelectorAll('.prose pre').forEach((pre) => {
      const wrapper = pre as HTMLElement;
      wrapper.style.position = 'relative';
      const btn = document.createElement('button');
      btn.textContent = 'Copy';
      btn.style.cssText = 'position:absolute;top:0.75rem;right:0.75rem;font-size:0.75rem;padding:0.25rem 0.5rem;border-radius:6px;background:var(--color-border);color:var(--color-text-tertiary);cursor:pointer;border:none;transition:color 0.15s';
      btn.addEventListener('mouseenter', () => { btn.style.color = 'var(--color-text-primary)'; });
      btn.addEventListener('mouseleave', () => { btn.style.color = 'var(--color-text-tertiary)'; });
      btn.addEventListener('click', () => {
        const code = wrapper.querySelector('code');
        navigator.clipboard.writeText(code?.textContent || '');
        btn.textContent = 'Copied!';
        setTimeout(() => { btn.textContent = 'Copy'; }, 2000);
      });
      wrapper.appendChild(btn);
    });
  </script>

  <script>
    const tocLinks = document.querySelectorAll('#toc a');
    const headings = document.querySelectorAll('#article-content h2, #article-content h3');
    if (tocLinks.length > 0 && headings.length > 0) {
      const obs = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              tocLinks.forEach(l => {
                l.classList.remove('!text-[color:var(--color-text-primary)]', '!font-medium');
              });
              const active = document.querySelector('#toc a[href="#' + entry.target.id + '"]');
              active?.classList.add('!text-[color:var(--color-text-primary)]', '!font-medium');
            }
          });
        },
        { rootMargin: '-80px 0px -60% 0px' }
      );
      headings.forEach(h => obs.observe(h));
    }

    // Hide TOC when footer enters viewport to avoid visual overlap
    const tocEl = document.getElementById('toc');
    const footerEl = document.querySelector('footer');
    if (tocEl && footerEl) {
      const footerObs = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            tocEl.style.opacity = entry.isIntersecting ? '0' : '1';
            tocEl.style.pointerEvents = entry.isIntersecting ? 'none' : 'auto';
          });
        },
        { rootMargin: '0px' }
      );
      footerObs.observe(footerEl);
    }
  </script>
</BaseLayout>
