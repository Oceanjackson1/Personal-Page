---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostSidebar from '../../components/PostSidebar.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).filter(p => p.data.category === 'travel').sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const collectionLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "旅居和探索 — Ocean's Blog",
  "description": "Ocean 在东南亚、日本等地旅居生活的见闻随笔。",
  "url": "https://niyutongocean.xyz/posts/travel/",
  "isPartOf": { "@type": "WebSite", "name": "Ocean's Blog", "url": "https://niyutongocean.xyz" },
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": posts.length,
    "itemListElement": posts.slice(0, 10).map((post, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "url": `https://niyutongocean.xyz/posts/${post.data.slug || post.id}/`
    }))
  }
};
---
<BaseLayout title="旅居和探索" description="Ocean 在东南亚、日本等地旅居生活的见闻随笔。">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(collectionLd)} />
  </Fragment>
  <section class="py-12 sm:py-16">
    <div class="max-w-[var(--width-wide)] mx-auto px-6">
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight mb-10" data-i18n-zh="旅居和探索" data-i18n-en="Travel">旅居和探索</h1>
      <div class="flex flex-col sm:flex-row sm:gap-16">
        <PostSidebar active="travel" />
        <div class="flex-1 min-w-0">
          {posts.map((post) => {
            const formattedDate = post.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
            return (
              <a href={`/posts/${post.data.slug || post.id}/`} class="block bg-[var(--color-surface)] rounded-2xl px-5 py-5 sm:px-7 sm:py-6 mb-4 hover:opacity-75 transition-opacity">
                <h3 class="text-base font-semibold text-[color:var(--color-text-primary)] mb-2">{post.data.title}</h3>
                <p class="text-sm text-[color:var(--color-text-secondary)] mb-4 line-clamp-2 leading-relaxed">{post.data.description}</p>
                <p class="text-sm text-[color:var(--color-text-secondary)]">旅居和探索 · {formattedDate}</p>
              </a>
            );
          })}
          {posts.length === 0 && <p class="text-[color:var(--color-text-tertiary)] py-8">暂无文章</p>}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
