---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).filter(p => p.data.category === 'products').sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="产品与工作流">
  <section class="py-16 sm:py-24">
    <div class="max-w-[var(--width-wide)] mx-auto px-6">
      <p class="text-lg text-[color:var(--color-text-primary)] leading-relaxed max-w-2xl mb-20" data-i18n-zh="面向用户的产品和提升效率的工作流工具" data-i18n-en="User-facing products and workflow efficiency tools">面向用户的产品和提升效率的工作流工具</p>
      <h2 class="font-mono text-xs uppercase tracking-widest text-[color:var(--color-text-tertiary)] mb-2" data-i18n-zh="产品与交易工具" data-i18n-en="Products & Trading Tools">产品与交易工具</h2>
      <div>
        {projects.map((project) => (
          <ProjectCard
            name={project.data.name}
            description={project.data.description}
            tech={project.data.tech}
            github={project.data.github}
            demo={project.data.demo}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
