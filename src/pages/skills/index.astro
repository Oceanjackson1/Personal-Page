---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SkillCard from '../../components/SkillCard.astro';
import { getCollection } from 'astro:content';

const allSkills = await getCollection('skills');
const sortedSkills = allSkills.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const categories = [
  { value: 'all', label: '全部' },
  { value: 'development', label: '开发' },
  { value: 'workflow', label: '工作流' },
  { value: 'research', label: '研究' },
  { value: 'writing', label: '写作' },
  { value: 'devops', label: 'DevOps' },
  { value: 'other', label: '其他' },
];
const skillsListLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Claude Code Skills 合集",
  "description": "最全的 Claude Code Skills 合集，涵盖开发、DevOps、工作流、AI Agent 等社区精选 Skill",
  "url": "https://niyutongocean.xyz/skills/",
  "numberOfItems": sortedSkills.length,
  "itemListElement": sortedSkills.slice(0, 50).map((skill, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "url": `https://niyutongocean.xyz/skills/${skill.id}/`,
    "name": skill.data.title
  }))
};
---

<BaseLayout
  title="Claude Code Skills 合集 — 500+ 精选 Skill 推荐"
  description="精选 Claude Code Skills 合集，涵盖开发、DevOps、工作流、AI Agent 等 500+ 个高质量社区 Skill。免费探索并提升 AI 编程效率。"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(skillsListLd)} />
  </Fragment>
  <section class="py-8 sm:py-24">
    <div class="max-w-[var(--width-wide)] mx-auto px-4 sm:px-6">

      <!-- Intro -->
      <div class="max-w-2xl mb-8 sm:mb-16">
        <h1 class="text-2xl sm:text-4xl font-bold tracking-tight mb-3 sm:mb-4">Claude Code Skills 合集</h1>
        <p class="text-base sm:text-lg text-[color:var(--color-text-primary)] leading-relaxed">500+ 精选高质量 Claude Code Skills</p>
        <p class="text-base sm:text-lg text-[color:var(--color-text-secondary)] leading-relaxed">探索开发、DevOps、工作流、AI Agent 等各领域的 Claude 技能</p>
        <div class="flex items-center gap-2 mt-4">
          <span class="inline-flex items-center gap-1.5 text-xs px-3 py-1.5 rounded-full border border-[var(--color-border)] text-[color:var(--color-text-tertiary)]">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" />
            </svg>
            内容来自开源社区
          </span>
        </div>
      </div>

      <!-- Category filter -->
      <div class="flex flex-wrap gap-1.5 sm:gap-2 mb-6 sm:mb-8 -mx-1 px-1 overflow-x-auto scrollbar-hide" id="skill-filters">
        {categories.map(cat => (
          <button
            data-category={cat.value}
            class:list={[
              "skill-filter-btn text-xs sm:text-sm px-3 sm:px-4 py-1 sm:py-1.5 rounded-full border transition-colors duration-200 whitespace-nowrap shrink-0",
              cat.value === 'all'
                ? "border-[color:var(--color-text-primary)] text-[color:var(--color-text-primary)]"
                : "border-[var(--color-border)] text-[color:var(--color-text-tertiary)] hover:text-[color:var(--color-text-secondary)] hover:border-[color:var(--color-text-tertiary)]"
            ]}
          >
            {cat.label}
          </button>
        ))}
      </div>

      <!-- Skill count -->
      <p class="text-xs text-[color:var(--color-text-tertiary)] mb-6" id="skill-count">
        共 {sortedSkills.length} 个 Skill
      </p>

      <!-- Skills list -->
      <div id="skills-list">
        {sortedSkills.map(skill => (
          <div data-skill-category={skill.data.category}>
            <SkillCard
              title={skill.data.title}
              description={skill.data.description}
              category={skill.data.category}
              source={skill.data.source}
              sourceUrl={skill.data.sourceUrl}
              author={skill.data.author}
              tags={skill.data.tags}
              slug={skill.id}
            />
          </div>
        ))}
      </div>

    </div>
  </section>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll('.skill-filter-btn');
  const items = document.querySelectorAll('#skills-list > div');
  const countEl = document.getElementById('skill-count');

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const cat = (btn as HTMLElement).dataset.category;

      buttons.forEach(b => {
        b.classList.remove('border-[color:var(--color-text-primary)]', 'text-[color:var(--color-text-primary)]');
        b.classList.add('border-[var(--color-border)]', 'text-[color:var(--color-text-tertiary)]');
      });
      btn.classList.remove('border-[var(--color-border)]', 'text-[color:var(--color-text-tertiary)]');
      btn.classList.add('border-[color:var(--color-text-primary)]', 'text-[color:var(--color-text-primary)]');

      let visible = 0;
      items.forEach(item => {
        const el = item as HTMLElement;
        if (cat === 'all' || el.dataset.skillCategory === cat) {
          el.style.display = '';
          visible++;
        } else {
          el.style.display = 'none';
        }
      });

      if (countEl) countEl.textContent = `共 ${visible} 个 Skill`;
    });
  });
</script>
