---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const skills = await getCollection('skills');
  return skills.map(skill => ({
    params: { slug: skill.id },
    props: { skill },
  }));
}

const { skill } = Astro.props;
const { Content } = await render(skill);

const sourceLabel = skill.data.source === 'community' ? '社区公开' : '官方';
const categoryLabels: Record<string, string> = {
  development: '开发',
  workflow: '工作流',
  research: '研究',
  writing: '写作',
  devops: 'DevOps',
  other: '其他',
};

const skillLd = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": `${skill.data.title} — Claude Code Skill`,
  "description": skill.data.description,
  "url": `https://niyutongocean.xyz/skills/${skill.id}/`,
  "datePublished": skill.data.date.toISOString(),
  ...(skill.data.author ? { "author": { "@type": "Person", "name": skill.data.author } } : {}),
  "publisher": { "@type": "Person", "name": "Ocean 倪钰桐" },
  "inLanguage": "zh-CN",
  "keywords": [...skill.data.tags, "Claude Code", "Claude Skill", "AI coding"],
  "about": { "@type": "SoftwareApplication", "name": "Claude Code", "applicationCategory": "DeveloperApplication" }
};

const skillBreadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Ocean's Blog", "item": "https://niyutongocean.xyz" },
    { "@type": "ListItem", "position": 2, "name": "Claude Skill", "item": "https://niyutongocean.xyz/skills/" },
    { "@type": "ListItem", "position": 3, "name": skill.data.title }
  ]
};
---

<BaseLayout
  title={`${skill.data.title} | Claude Skill`}
  description={skill.data.description}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(skillLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(skillBreadcrumbLd)} />
  </Fragment>
  <article class="py-8 sm:py-20">
    <div class="max-w-[var(--width-content)] mx-auto px-4 sm:px-6">

      <!-- Back link -->
      <a href="/skills/" class="inline-flex items-center gap-1.5 text-sm text-[color:var(--color-text-tertiary)] hover:text-[color:var(--color-text-primary)] transition-colors mb-8">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7" />
        </svg>
        返回 Claude Skill
      </a>

      <!-- Header -->
      <header class="mb-10">
        <h1 class="text-xl sm:text-3xl font-bold tracking-tight mb-3 sm:mb-4">{skill.data.title}</h1>
        <p class="text-base text-[color:var(--color-text-secondary)] leading-relaxed mb-4">{skill.data.description}</p>

        <div class="flex flex-wrap items-center gap-2">
          <span class="inline-block text-[11px] px-2.5 py-1 rounded-full border border-[var(--color-border)] text-[color:var(--color-text-tertiary)]">
            {categoryLabels[skill.data.category] || skill.data.category}
          </span>
          <span class="inline-flex items-center gap-1 text-[11px] px-2.5 py-1 rounded-full bg-[var(--color-card-bg)] text-[color:var(--color-text-tertiary)]">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" />
            </svg>
            {sourceLabel}
          </span>
          {skill.data.author && (
            <span class="text-[11px] text-[color:var(--color-text-tertiary)]">
              by {skill.data.author}
            </span>
          )}
        </div>

        <div class="flex flex-wrap items-center gap-3 mt-4">
          <button
            id="download-btn"
            data-slug={skill.id}
            data-title={skill.data.title}
            data-category={skill.data.category}
            class="inline-flex items-center gap-1.5 text-sm px-4 py-2 rounded-full border border-[var(--color-text-primary)] text-[color:var(--color-text-primary)] hover:bg-[var(--color-text-primary)] hover:text-[var(--color-bg)] transition-all cursor-pointer"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
            </svg>
            下载 SKILL.md
          </button>
          {skill.data.sourceUrl && (
            <a href={skill.data.sourceUrl} target="_blank" rel="noopener noreferrer"
               class="inline-flex items-center gap-1.5 text-sm text-[color:var(--color-text-tertiary)] hover:text-[color:var(--color-text-primary)] transition-colors">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
              </svg>
              查看原始来源
            </a>
          )}
        </div>
      </header>

      <hr class="border-[var(--color-border)] mb-10" />

      <!-- Content -->
      <div class="prose">
        <Content />
      </div>

      {skill.data.tags.length > 0 && (
        <div class="mt-12 pt-6 border-t border-[var(--color-border)]">
          <div class="flex flex-wrap gap-2">
            {skill.data.tags.map(tag => (
              <span class="text-xs px-3 py-1 rounded-full border border-[var(--color-border)] text-[color:var(--color-text-tertiary)]">
                #{tag}
              </span>
            ))}
          </div>
        </div>
      )}

    </div>
  </article>

  <script>
    const btn = document.getElementById('download-btn');
    if (btn) {
      btn.addEventListener('click', () => {
        const slug = btn.dataset.slug || 'skill';
        const title = btn.dataset.title || slug;

        // Gather content from the prose section
        const proseEl = document.querySelector('.prose');
        if (!proseEl) return;

        // Build SKILL.md content
        const frontmatter = `---\nname: ${slug}\ndescription: ${title}\n---\n\n`;
        // Convert HTML to approximate markdown
        const content = proseEl.innerText || proseEl.textContent || '';
        const md = frontmatter + content;

        // Trigger download
        const blob = new Blob([md], { type: 'text/markdown;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `${slug}.md`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);

        // Track download count
        const current = parseInt(localStorage.getItem('skill-downloads-total') || '0');
        localStorage.setItem('skill-downloads-total', String(current + 1));

        window.amplitude?.track('Skill Downloaded', {
          skill_slug: slug,
          skill_title: title,
          skill_category: btn.dataset.category || '',
        });

        // Visual feedback
        const originalText = btn.innerHTML;
        btn.innerHTML = `<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.5 12.75l6 6 9-13.5" /></svg> 已下载`;
        setTimeout(() => { btn.innerHTML = originalText; }, 2000);
      });
    }
  </script>
</BaseLayout>
