---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import VisitorStats from '../components/VisitorStats.astro';
import SearchModal from '../components/SearchModal.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description = "Ocean's Blog — 找到一个最长的雪坡，滚雪球", ogImage = "/avatar.jpg" } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />
  <title>{title.includes('Ocean') ? title : `${title} | Ocean`}</title>

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title.includes('Ocean') ? title : `${title} | Ocean`} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:locale" content="zh_CN" />
  <meta property="og:site_name" content="Ocean 倪钰桐 Blog" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@Ocean_Jackon" />
  <meta name="twitter:title" content={title.includes('Ocean') ? title : `${title} | Ocean`} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />

  <!-- Sitelinks / Navigation structured data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Ocean's Blog",
    "alternateName": "倪钰桐的个人主页",
    "url": "https://niyutongocean.xyz",
    "description": "找到一个最长的雪坡，滚雪球",
    "author": {
      "@type": "Person",
      "name": "Ocean 倪钰桐",
      "url": "https://niyutongocean.xyz"
    },
    "potentialAction": {
      "@type": "SearchAction",
      "target": "https://niyutongocean.xyz/?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SiteNavigationElement",
    "name": ["文章", "代码库", "城市生活记忆", "Claude Skills", "AI 分享", "问Ocean的龙虾"],
    "url": [
      "https://niyutongocean.xyz/posts/",
      "https://niyutongocean.xyz/code/",
      "https://niyutongocean.xyz/life/",
      "https://niyutongocean.xyz/skills/",
      "https://niyutongocean.xyz/ai-shares/",
      "https://niyutongocean.xyz/lobster/"
    ]
  })} />

  <!-- Extra head content (structured data etc.) -->
  <slot name="head" />

  <!-- Preload fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400&family=Noto+Serif+SC:wght@400;500;600;700&display=swap" rel="stylesheet" />

</head>
<body class="min-h-screen flex flex-col">
  <Nav />
  <main class="flex-1">
    <slot />
  </main>
  <VisitorStats />
  <Footer />
  <SearchModal />

  <!-- Amplitude Analytics + Session Replay (client-side only) -->
  <script>
    import * as amplitude from '@amplitude/unified';

    if (!window.__amplitudeInitialized) {
      window.__amplitudeInitialized = true;
      amplitude.initAll('8c87cdca6153fd695ac2d6cd9320b82f', {
        analytics: { autocapture: true },
        sessionReplay: { sampleRate: 1 },
      });
      window.amplitude = amplitude as unknown as Window['amplitude'];
    }
  </script>
</body>
</html>
